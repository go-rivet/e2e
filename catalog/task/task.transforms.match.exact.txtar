
# Test: exact match 
rivet
exists file_1.text
exists file_exact.out
exists .task
stdout 'Task default runs'
stdout '-> file_1.text'
! stdout '-> file_1.txt'
 
# Test: no change, no run
rivet
exists file_1.text
exists file_exact.out
exists .task
stdout ''

# Test: update match, run
touch file_1.text
rivet
exists file_1.text
exists file_exact.out
exists .task
stdout 'Task default runs'
stdout '-> file_1.text'
! stdout '-> file_1.txt'

# Test: delete yield, run
rm file_exact.out
! exists file_exact.out
rivet
exists file_1.text
exists file_exact.out
exists .task
stdout 'Task default runs'
stdout '-> file_1.text'
! stdout '-> file_1.txt'

# Test: delete .task, run
rm .task
rivet
exists file_1.text
exists file_exact.out
exists .task
stdout 'Task default runs'
stdout '-> file_1.text'
! stdout '-> file_1.txt'

 # Test: delete match, error
