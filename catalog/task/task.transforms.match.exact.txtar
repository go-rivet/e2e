 # stderr ''


-- Taskfile.yml --
version: '3'

tasks:
  default:
    cmds:
      - echo "Task {{.TASK}} runs"
      - for: sources
        cmd: echo "-> {{.ITEM}}"
      - touch file_exact.out
    transforms:
      - matches:
          - file_1.text 
        yields:
          - file_exact.out

-- file_1.txt --
-- file_1.text --
-- sub/file_1.txt --
-- sub/dir/file_1.txt --
