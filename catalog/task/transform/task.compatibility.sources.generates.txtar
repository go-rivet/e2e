
# Test: globstar match 
rivet globstar
exists file_globstar.out
exists .task
stdout 'Task globstar runs'
stdout 'source -> file_1.txt'
stdout 'source -> file_2.txt'
stdout 'source -> sub/file_3.txt'
stdout '-> sub/dir/file_4.txt'
stdout '-> sub/dir/file_5.txt'
! stdout '-> foo_1.bar'
! stdout '-> sub/dir/foo_1.bar'
stdout '-> file_globstar.out'

 
# Test: no change, no run
rivet globstar
exists file_globstar.out
exists .task
stdout ''


-- Taskfile.yml --
version: '3'

tasks:
  globstar:
    cmds:
      - echo "Task {{.TASK}} runs"
      - for: sources
        cmd: echo "source -> {{.ITEM}}"
      - for: generates
        cmd: echo "generate -> {{.ITEM}}"
      - touch file_{{.TASK}}.out
    sources:
      - ./**/*.txt 
    generates:
      - file_{{.TASK}}.out

-- file_1.txt --
-- file_2.txt --
-- foo_1.bar --
-- sub/file_3.txt --
-- sub/foo_1.bar --
-- sub/dir/file_4.txt --
-- sub/dir/file_5.txt --
-- sub/dir/foo_1.bar --
