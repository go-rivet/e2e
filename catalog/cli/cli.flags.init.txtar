# Test: init
rivet --init
stdout ''
stderr ''
exists Taskfile.yml
filecontains Taskfile.yml expect
rivet
stdout 'Hello, world!'

# Test: init w. verbose and filename
rivet -v --init foobar.yml
stdout ''
stderr 'Taskfile created: foobar.yml'
exists foobar.yml
filecontains foobar.yml expect
rivet
stdout 'Hello, world!'

-- expect --
version: '3'

vars:
  GREETING: Hello, world!

tasks:
  default:
    desc: Print a greeting message
    cmds:
      - echo "{{.GREETING}}"
    silent: true