exec ls -al
exec cat Taskfile.yml

# Test: taskfile set with config
rivet msg
stdout 'config taskfile'

# Setup: set env
env RIVET_TASKFILE=Taskfile.env.yml 

# Test: taskfile set with flag 
rivet -t Taskfile.flag.yml msg
stdout 'flag taskfile'

# Test: taskfile set with env
rivet -vv msg
stdout 'env taskfile'

# Setup: set env to ""
env RIVET_TASKFILE=

# Test: taskfile with config, env set"" disables, should default
rivet msg
stdout 'default taskfile'


-- Taskfile.yml --
version: '3'
tasks:
  msg:
    cmds:
      - echo "default taskfile"

-- Taskfile.flag.yml --
version: '3'
tasks:
  msg:
    cmds:
      - echo "flag taskfile"

-- Taskfile.env.yml --
version: '3'
tasks:
  msg:
    cmds:
      - echo "env taskfile"

-- Taskfile.config.yml --
version: '3'
tasks:
  msg:
    cmds:
      - echo "config taskfile"

-- rivet.env --
RIVET_TASKFILE=Taskfile.config.yml
