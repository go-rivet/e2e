exec ls -al
exec cat Taskfile.yml

# Test: Override via RIVET_ENV 
env RIVET_ENV=override/rivet.env
rivet msg
stdout 'Message: Override RIVET_ENV'

# Clear: RIVET_ENV
env RIVET_ENV=

# Test: local workspace visible 
cd local/workspace
rivet msg
stdout 'Message: local workspace visible'

# Test: local workspace hidden 
rm rivet.env
rivet msg
stdout 'Message: local workspace hidden'

# Test: taskfile directory visible 
rm .rivet.env
rivet msg
stdout 'Message: taskfile directory visible'

# Test: taskfile directory hidden 
rm $WORK/rivet.env
rivet msg
stdout 'Message: taskfile directory hidden'

# Mock: HOME 
env HOME=$WORK/mockhome

# Test: modern linux XDG configuration 
rm $WORK/.rivet.env
rivet msg
stdout 'Message: modern linux XDG configuration'

# Test: legacy user home directory 
rm $HOME/.config/rivet/rivet.env
rivet msg
stdout 'Message: legacy user home directory'


-- Taskfile.yml --
version: '3'

tasks:
  msg:
    cmds:
      - 'echo "Message: {{.MSG}}"'

-- override/rivet.env --
MSG=Override RIVET_ENV

-- local/workspace/rivet.env --
MSG=local workspace visible

-- local/workspace/.rivet.env --
MSG=local workspace hidden

-- rivet.env --
MSG=taskfile directory visible

-- .rivet.env --
MSG=taskfile directory hidden

-- mockhome/.config/rivet/rivet.env --
MSG=modern linux XDG configuration

-- mockhome/.rivet.env --
MSG=legacy user home directory
